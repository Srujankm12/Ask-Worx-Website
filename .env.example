# Resend — https://resend.com/api-keys
# Required for the contact form to send email. Without it the form tells the
# visitor email is not connected and points them at WhatsApp.
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to contact@askworx.in.
CONTACT_TO_EMAIL=contact@askworx.in

# The From address. Must be on a domain verified in Resend.
# It is used for both the enquiry notification and the acknowledgement the
# visitor receives, so a verified domain is required before the auto-reply
# reaches anyone: for testing, ASKworX <onboarding@resend.dev> works but
# Resend only delivers it to your own account email.
CONTACT_FROM_EMAIL=ASKworX Website <hello@askworx.in>
